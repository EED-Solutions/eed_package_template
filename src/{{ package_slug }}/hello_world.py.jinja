import logging

from eed_basic_utils.os import get_git_root

logger = logging.getLogger(__name__)


def hello_world() -> str:
    """
    Return a greeting message for the package.

    Returns
    -------
    str
        A greeting containing the package's Git repository root.
    """
    logger.debug("Building hello_world greeting.")
    git_root = get_git_root()
    return f"Hello from {git_root}!"
